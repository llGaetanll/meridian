  "query": "SELECT date_trunc('hour', at) AS \"hour!\",\n                  count(*) AS \"asked!\",\n                  count(*) FILTER (WHERE outcome <> 'ok') AS \"faulted!\"\n           FROM fetch_log\n           WHERE at >= $1\n           GROUP BY 1\n           ORDER BY 1",
