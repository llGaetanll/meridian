  "query": "SELECT e.id, e.account_id, e.ts, e.currency, e.amount_minor, e.label,\n                e.category, e.logo_url, e.pending, e.supersedes\n         FROM entries e\n         JOIN items i USING (item_id)\n         WHERE i.user_id = $1\n         ORDER BY e.ts DESC, e.id ASC",
