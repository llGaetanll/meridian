{
  "db_name": "PostgreSQL",
  "query": "SELECT ts, close FROM (\n               SELECT ts, close,\n                      row_number() OVER (ORDER BY ts) AS rn,\n                      count(*) OVER () AS total\n               FROM bars\n               WHERE source = $1 AND symbol = $2 AND interval = $3 AND ts >= $4\n           ) points\n           WHERE (rn - 1) % GREATEST(total / $5, 1) = 0\n           ORDER BY ts",
