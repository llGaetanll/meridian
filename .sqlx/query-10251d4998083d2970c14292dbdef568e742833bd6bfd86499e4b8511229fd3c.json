  "query": "SELECT symbol, avg(volume * close)::float8 AS \"turnover!\" FROM (\n               SELECT symbol, volume, close,\n                      row_number() OVER (PARTITION BY symbol ORDER BY ts DESC) AS rn\n               FROM bars\n               WHERE source = $1 AND interval = '1d'\n           ) newest\n           WHERE rn <= $2\n           GROUP BY symbol",
