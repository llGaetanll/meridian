# The web app's container: the files trunk built, over plain http on 3000.
#
# TLS, HSTS and the log are the root Caddyfile's, which is the one on the
# internet and reaches this one as `web:3000` over the compose network.
{
	admin off
	persist_config off
	auto_https off
}

:3000 {
	root * /srv

	# trunk names what it builds for its content — `web-main-<hash>.js`, the
	# wasm beside it, `input-<hash>.css`, `snippets/<crate>-<hash>/` — so a
	# name never comes to mean different bytes, and those are kept for a year.
	# Everything else is asked about on every load: `index.html`, which names
	# the rest, and `linked.html`, where Plaid sends the bank's window back.
	@hashed path_regexp ^/snippets/|-[0-9a-f]{16}(_bg)?\.(css|js|wasm)$
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	header ?Cache-Control no-cache

	file_server {
		precompressed br
	}
}
