<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key>
    <string>Meridian</string>
    <key>CFBundleIdentifier</key>
    <string>com.meridian.phone</string>
    <key>CFBundleName</key>
    <string>Meridian</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>MinimumOSVersion</key>
    <string>17.0</string>
    <key>UIDeviceFamily</key>
    <array>
        <integer>1</integer>
    </array>
    <key>UILaunchScreen</key>
    <dict/>
    <!-- The scheme Plaid redirects to when the bank sign-in ends. Registering
         it is what lets iOS hand that redirect back to the app and close the
         web sheet; without this the sheet sits there having succeeded.

         It has to match COMPLETION_REDIRECT in crates/server-main's
         runtime_plaid.rs, which is what the server puts on the link token.
         The redirect carries no token — its only job is to close the sheet —
         so nothing reads the URL, only the fact that it arrived. -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.meridian.phone.link</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>meridian</string>
            </array>
        </dict>
    </array>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
    <!-- The icon lives in Assets.car, which the build compiles out of
         swift/Support/Assets.xcassets. iOS finds it by name from here. -->
    <key>CFBundleIconName</key>
    <string>AppIcon</string>
    <!-- Where server-main listens, read by RuntimeIo. The hosted server is
         the answer that ships: https to a real name, which is what App
         Transport Security wants by default, so the bundle asks for no
         exemption.

         A build pointed at a laptop is the exception, and both build scripts
         write that address into the copy under target/ rather than here —
         along with the exemption plain http then needs. See ios-run.sh and
         ios-device.sh. -->
    <key>MeridianServer</key>
    <string>https://api.meridiancash.io</string>
</dict>
</plist>
