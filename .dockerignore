# Keep the build context small and the layers stable. Anything in here that
# changed would invalidate the dependency cache for no reason — `target` alone
# is several gigabytes of it.

target/
.git/
logs/
*.log

# Secrets never enter an image. Compose passes them as environment at run
# time, which is also the only way they stay out of `docker history`.
.env
.env.*
!.env.example

# How the server is *run*, which is nothing the compiler needs — and every one
# of these is edited far more often than the code. Left in the context, a
# comment reworded in the Caddyfile invalidates `COPY . .` and rebuilds
# server-main to produce a byte-identical binary.
Caddyfile
docker-compose*.yml

# Nothing the server is built from.
swift/
kotlin/
sketches/
docs/
compile_commands.json
