/target
/**/dist

# Logs, at any depth. `/logs` alone only matched the root, which let
# crates/src-plaid/logs/meridian.log into the tree.
logs/
*.log

# Secrets. Sandbox only — see docs/PLAID.md.
.env
.env.*
# ...except the one with no secrets in it, which is how anyone knows what to
# put in the others.
!.env.example

# Generated by scripts/ios-run.sh for sourcekit-lsp, from the flags that
# built the app. Regenerated on every run, so there is nothing to keep in step.
/compile_commands.json

# Database dumps, from scripts/backup.sh. Real rows: every transaction, every
# email address, and the sealed access tokens. Never in the tree's history.
backups/
*.dump

# The database's TLS certificates, from scripts/db-certs.sh. Per machine and
# never shared: the laptop makes its own and so does the box, because a private
# key that travels has been on two disks and in whatever carried it.
certs/

# Apple's are the opposite: public certificates, the same on every machine,
# and the server cannot verify a purchase without the root among them.
!crates/src-apple/certs/

.claude/
