/target
/**/dist

# Logs, at any depth. `/logs` alone only matched the root, which let
# crates/src-plaid/logs/meridian.log into the tree.
logs/
*.log

# Secrets. Sandbox only — see docs/PLAID.md.
.env
.env.*
# ...except the one with no secrets in it, which is how anyone knows what to
# put in the others.
!.env.example

# Generated by scripts/ios-run.sh for sourcekit-lsp, from the flags that
# built the app. Regenerated on every run, so there is nothing to keep in step.
/compile_commands.json
